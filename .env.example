# Kopiere diese Datei nach .env und trage deine Werte ein. .env wird nie committet.

# Aus dem Ford-Entwicklerportal (developer.ford.com/developer-eu), bei deiner App
FORD_CLIENT_ID=
FORD_CLIENT_SECRET=

# Muss exakt so im Ford-Portal als Redirect URI eingetragen sein
FORD_REDIRECT_URI=http://localhost:8080/callback

# Wie oft Ford abgefragt wird (Minuten, mindestens 2)
POLL_INTERVAL_MINUTES=5

# Nur für `npm run dev`: nach dem Login zur Vite-Oberfläche zurück
# FRONTEND_URL=http://localhost:5173

# Zeitzone für die Kilometerstand-Übersicht (Tage, Wochen, Monate)
# TIME_ZONE=Europe/Berlin

# Login für die Weboberfläche (Passwort, im Profil kommen Passkeys dazu).
# Im Docker-Container ist die App ohne diese Werte gesperrt, bei `npm run dev` offen.
# Hash erzeugen: docker run --rm caddy:2 caddy hash-password --plaintext 'dein-passwort'
# Den Hash in einfache Anführungszeichen setzen, wegen der $-Zeichen.
# Auf dem Server stehen diese Werte in deploy/caddy.env (legt deploy/setup.sh an).
# LOGIN_USER=noah
# LOGIN_HASH='$2a$14$...'
# Adresse der App ohne https:// (Passkeys gehören zu genau dieser Adresse). Leer = Adresse aus dem Browser.
# DOMAIN=ford.example.de
