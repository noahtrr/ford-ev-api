# Kopiere diese Datei nach .env und trage deine Werte ein. .env wird nie committet.

# Aus dem Ford-Entwicklerportal (developer.ford.com/developer-eu), bei deiner App
FORD_CLIENT_ID=
FORD_CLIENT_SECRET=

# Muss exakt so im Ford-Portal als Redirect URI eingetragen sein
FORD_REDIRECT_URI=http://localhost:8080/callback

# Wie oft Ford abgefragt wird (Minuten, mindestens 2)
POLL_INTERVAL_MINUTES=5

# Nur für `npm run dev`: nach dem Login zur Vite-Oberfläche zurück
# FRONTEND_URL=http://localhost:5173
